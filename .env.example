# Bootstrap env vars for Franchisarr. All of these can also be set/changed later via the in-app
# setup wizard and Settings UI once the app is running (they're a convenience, not the only path).
#
# They seed the database on FIRST BOOT ONLY, while the settings table is still empty. After that
# the database wins and these are ignored, so a value you change in the UI won't be reverted by a
# stale line in this file on the next restart.
#
# Comments must be on their own line. Docker's env_file parser does not strip trailing comments,
# so `BASE_URL=/   # a comment` would set the base URL to the literal string "/   # a comment".

PLEX_URL=
# Plex auth token. Phase 2 replaces this with "Sign in with Plex" (OAuth); until then it is how
# the app reaches your server.
PLEX_TOKEN=

# Your own free key from https://www.themoviedb.org/settings/api — not bundled with the app.
TMDB_API_KEY=
# How long TMDb collection/show lookups stay cached before being refreshed.
TMDB_CACHE_TTL_DAYS=7

# e.g. /franchisarr if served under a reverse-proxy subpath. Use / when serving at the root.
BASE_URL=/
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Path to the SQLite database. Defaults to franchisarr.db inside the mounted config volume;
# set this only if you want the database somewhere else.
# DB_PATH=/config/franchisarr.db

# Container user (linuxserver.io convention) — matches Radarr/Sonarr/Plex's own containers
PUID=1000
PGID=1000

# Optional first Radarr/Sonarr (more can be added in the Settings UI afterwards).
#
# Use the address on your own network, not a public one. If Radarr and Sonarr run in Docker, put
# Franchisarr on the same network and use their container names — as below. A public URL that
# sits behind a login proxy (Authelia, Authentik, Cloudflare Access) will NOT work: those answer
# API requests with a login page, and an API key can't get past one.
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# Treat a movie/show present in ANY configured instance of that type as "already have it",
# instead of each instance's gap list being independent. Useful when instances are split by
# content type (e.g. TV vs. anime Sonarr) rather than by quality tier.
CROSS_INSTANCE_DEDUP=false

# Fallback local admin account. Created on first boot only, and never used to reset an existing
# password afterwards — so changing it here later has no effect. This is the recovery login for
# when Plex sign-in isn't available (Plex not configured yet, plex.tv unreachable, offline LAN).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set to true when Franchisarr is served over HTTPS, so session cookies carry the Secure flag.
# Leave false for a plain-HTTP LAN install, where a Secure cookie would never be sent at all.
SESSION_COOKIE_SECURE=false

# Optional scheduling/notifications bootstrap (also editable in Settings UI).
# e.g. "0 3 * * *" for nightly at 3am; empty disables scheduled scans.
# Times are this container's local time — set TZ below to control which that is.
SCAN_SCHEDULE_CRON=

# Container timezone, so scheduled scans run when you expect. e.g. America/Chicago, Europe/London.
TZ=UTC
WEBHOOK_URL=
# generic | discord | slack
WEBHOOK_FORMAT=generic
