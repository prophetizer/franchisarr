# Bootstrap env vars for Franchisarr. All of these can also be set/changed later via the in-app
# setup wizard and Settings UI once the app is running (they're a convenience, not the only path).

PLEX_URL=
PLEX_TOKEN=            # or OAuth client id/secret, TBD during Phase 2
TMDB_API_KEY=          # your own free key from themoviedb.org/settings/api — not bundled
BASE_URL=/             # e.g. /franchisarr if served under a reverse-proxy subpath
LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR, structured JSON-ish lines to stdout

# Container user (linuxserver.io convention) — matches Radarr/Sonarr/Plex's own containers
PUID=1000
PGID=1000

# Optional single-instance bootstrap (further instances added via the Settings UI):
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=

# Fallback local admin account (used if Plex OAuth login isn't available/configured yet)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional scheduling/notifications bootstrap (also editable in Settings UI):
SCAN_SCHEDULE_CRON=    # e.g. "0 3 * * *" for nightly at 3am; empty disables scheduled scans
WEBHOOK_URL=
WEBHOOK_FORMAT=generic  # generic | discord | slack
